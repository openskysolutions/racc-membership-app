generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table - minimal schema for authentication only
// All profile data (firstName, lastName, businessName, phone, etc.) comes from GoHighLevel
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  passwordHash  String
  role          String    @default("member")
  status        String    @default("pending")
  emailVerified Boolean   @default(false)
  ghlContactId  String?   @unique
  ghlBusinessId String?             // Cached from GHL Contact's businessId field (synced at login)
  isMainContact             Boolean   @default(false) // Cached from GHL tag 'main-contact'
  isBusinessProfileEditor   Boolean   @default(false) // Cached from GHL tag 'business-profile-editor'
  lastLoginAt   DateTime?
  hideMembershipTier        Boolean   @default(false)
  passwordResetToken        String?
  passwordResetTokenExpiry  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  memberCard    MemberCard?
  sessions      Session[]
  votes         Vote[]
  jobs          Job[]
  deviceTokens  DeviceToken[]
  notifications Notification[]
  electionVotes ElectionVote[]

  @@index([email])
  @@index([ghlContactId])
  @@index([passwordResetToken])
  @@map("users")
}

// Sessions table for authentication tokens
model Session {
  id          Int      @id @default(autoincrement())
  userId      Int
  sessionId   String   @unique
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("sessions")
}

// Nominations table for Business of the Month and Customer Service Superstar awards
model Nomination {
  id           Int      @id @default(autoincrement())
  type         String   // 'business' or 'individual'
  category     String   // 'business_of_month' or 'customer_service_superstar'
  name         String?  // Individual's name (for customer service superstar)
  businessName String   // Business name
  reason       String   @db.Text
  status       String   @default("pending") // pending, approved, rejected
  isWinner     Boolean  @default(false) // Marked as winner by admin
  winnerMonth  String?  // Format: YYYY-MM (month for which this nomination won)
  winnerYear   String?  // Format: YYYY (year for which this nomination won - for yearly awards)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  votes        Vote[]
  
  @@index([type, category])
  @@index([status])
  @@index([createdAt])
  @@index([isWinner])
  @@map("nominations")
}

// Votes table for board members to vote on nominations
model Vote {
  id              Int        @id @default(autoincrement())
  nominationId    Int
  userId          Int        // Board member who voted
  votingMonth     String     // Format: YYYY-MM (e.g., "2025-01" for voting in January for February winners)
  votingCategory  String     // 'business_of_month' or 'customer_service_superstar'
  voteType        String     @default("monthly") // 'monthly' or 'yearly'
  voteValue       Boolean    @default(true) // Simple yes/no vote (checkbox)
  comment         String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  // Relations
  nomination   Nomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, votingCategory, votingMonth, voteType]) // One vote per user per category per month per type
  @@index([nominationId])
  @@index([userId])
  @@index([votingMonth])
  @@index([voteType])
  @@map("votes")
}

// Job postings table - chamber members can post job opportunities
model Job {
  id                     Int              @id @default(autoincrement())
  title                  String
  company                String
  location               String
  type                   String           // full-time, part-time, contract, internship
  salary                 String?
  description            String           @db.Text
  requirements           String?          @db.Text // JSON array stored as text
  postedById             Int              // Member who posted the job
  expiresAt              DateTime?
  status                 String           @default("active") // active, closed, expired
  externalApplicationUrl String?          // Optional: redirect to external site for application
  viewCount              Int              @default(0) // Track how many times job has been viewed
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  
  // Relations
  postedBy               User             @relation(fields: [postedById], references: [id], onDelete: Cascade)
  applications           JobApplication[]
  
  @@index([postedById])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("jobs")
}

// Job applications table - anyone can apply for jobs
model JobApplication {
  id                     Int      @id @default(autoincrement())
  jobId                  Int
  applicantName          String
  applicantEmail         String
  applicantPhone         String?
  coverLetter            String?  @db.Text
  resumeFileUrl          String?  // URL to uploaded resume file
  resumeFileName         String?  // Original filename
  resumeGoogleDocLink    String?  // Optional Google Doc link
  status                 String   @default("pending") // pending, reviewed, shortlisted, rejected
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  
  // Relations
  job                    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@index([jobId])
  @@index([applicantEmail])
  @@index([status])
  @@index([createdAt])
  @@map("job_applications")
}

// Member business categories - stores subcategory selections per GHL business.
// ghlContactId is retained for backward compat; ghlBusinessId is added now and
// populated by the Phase 9 migration script. ghlContactId will be dropped in Phase 10.
model MemberCategory {
  id            Int      @id @default(autoincrement())
  ghlContactId  String?  // Legacy — kept until Phase 9 migration script backfills ghlBusinessId
  ghlBusinessId String?  // New — GoHighLevel Business ID; populated by Phase 9 script
  subcategory   String   // Subcategory id, e.g. "restaurants", "hvac"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ghlContactId])
  @@index([ghlBusinessId])
  @@index([subcategory])
  @@map("member_categories")
}

// Extended business profile data that GHL Business objects don't support as native fields.
// One row per GHL Business. Mirrors the pattern used for MemberCategory.

model BusinessProfile {
  id               Int      @id @default(autoincrement())
  ghlBusinessId    String   @unique
  avatar           String?
  coverImage       String?
  tagline          String?
  bio              String?  @db.Text
  membershipTier   String?
  memberSince      String?
  couponCodes      String[] @default([])
  specialties      String[] @default([])
  organizationType String?
  facebookUrl      String?
  instagramUrl     String?
  twitterUrl       String?
  linkedinUrl      String?
  hideMembershipTier Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("business_profiles")
}

// Business category definitions — single source of truth for the category tree
model BusinessCategory {
  id            String               @id // e.g. "food-beverage"
  name          String
  icon          String               // lucide-react icon name, e.g. "Utensils"
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  subcategories BusinessSubcategory[]

  @@map("business_categories")
}

model BusinessSubcategory {
  id         String           @id // e.g. "restaurants"
  name       String
  categoryId String
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  category   BusinessCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("business_subcategories")
}

// Blog post categories
model PostCategory {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  slug        String   @unique
  img         String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  posts       Post[]
  
  @@index([slug])
  @@map("post_categories")
}

// Blog post authors
model PostAuthor {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  image       String
  bio         String?  @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  posts       Post[]
  
  @@index([slug])
  @@map("post_authors")
}

// Blog posts
model Post {
  id         String       @id @default(cuid())
  title      String
  metadata   String?      @db.Text // SEO meta description
  slug       String       @unique
  authorId   Int
  categoryId Int
  tags       String[]     // Array of tags
  mainImage  String?      // Main post image URL (optional)
  body       String       @db.Text // Rich text content (HTML)
  published  Boolean      @default(false) // Whether post is publicly visible
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  
  // Relations
  author     PostAuthor   @relation(fields: [authorId], references: [id])
  category   PostCategory @relation(fields: [categoryId], references: [id])
  galleries  Gallery[]    // Post can have multiple galleries
  
  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([createdAt])
  @@index([published])
  @@map("posts")
}

// Gallery for blog posts - each post can have multiple galleries with titles
model Gallery {
  id           String   @id @default(cuid())
  postId       String
  title        String   // Gallery title (e.g., "Event Photos", "Product Showcase")
  images       String[] // Array of image URLs
  displayOrder Int      @default(0) // Order for displaying galleries
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  @@index([postId])
  @@index([postId, displayOrder])
  @@map("galleries")
}

// Form Embeds - Securely store form embed codes
model FormEmbed {
  id                String   @id @default(cuid())
  name              String   // Display name for the form
  
  // Legacy field - kept for backward compatibility
  embedCode         String?  @db.Text // The actual embed code (iframe, script, etc.)
  
  // New fields for different membership tiers
  basicEmbedCode    String?  @db.Text
  enhancedEmbedCode String?  @db.Text
  eliteEmbedCode    String?  @db.Text
  
  // Alternative: external URL instead of embed codes
  externalUrl       String?  @db.Text
  
  createdBy         Int?     // Optional: User who created it
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([createdBy])
  @@map("form_embeds")
}

// Device tokens for push notifications
model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String   // 'ios' | 'android' | 'web'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// Generic key-value settings store for admin-configurable options
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// Notification inbox — one record per user per sent notification
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// Tracks which event reminder slots have already been sent (persistent dedup)
model EventReminderLog {
  id        Int      @id @default(autoincrement())
  eventId   String   // GHL event ID
  slot      String   // "1" or "2" — which reminder slot
  sentAt    DateTime @default(now())

  @@unique([eventId, slot])
  @@index([sentAt])
  @@map("event_reminder_logs")
}

// Per-event flags stored locally (not synced to GoHighLevel)
model EventFlag {
  eventId              String   @id     // GHL event/appointment ID
  excludeFromReminders Boolean  @default(false)
  updatedAt            DateTime @updatedAt

  @@map("event_flags")
}

// Executive board member elections: a position (e.g. "Treasurer") open for a vote
model ElectionPosition {
  id                    Int       @id @default(autoincrement())
  title                 String
  description           String?   @db.Text
  seatsAvailable        Int       @default(1)
  status                String    @default("draft") // draft, nominations, voting_open, voting_closed, results_published
  votingStartAt         DateTime?
  votingEndAt           DateTime?
  votingClosedManually  Boolean   @default(false)
  resultsPublishedAt    DateTime?
  // Executive Director's picks to break a tie for the last seat(s); empty until resolved
  tieBreakWinnerIds     Int[]     @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  candidates ElectionCandidate[]
  votes      ElectionVote[]

  @@index([status])
  @@map("election_positions")
}

// A chamber member nominated as a candidate for an ElectionPosition
model ElectionCandidate {
  id           Int      @id @default(autoincrement())
  positionId   Int
  name         String
  businessName String?
  statement    String?  @db.Text
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  position ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  votes    ElectionVote[]

  @@index([positionId])
  @@map("election_candidates")
}

// One ballot entry: a member's vote for a candidate on a position
model ElectionVote {
  id         Int      @id @default(autoincrement())
  positionId Int
  candidateId Int
  voterId    Int
  createdAt  DateTime @default(now())

  // Relations
  position  ElectionPosition  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  voter     User              @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([positionId, candidateId, voterId])
  @@index([positionId])
  @@index([candidateId])
  @@index([voterId])
  @@map("election_votes")
}



// Digital business card — one per user, created the first time they open "My Card".
// publicId is a stable, non-guessable token used in the QR code / share URL, so
// the QR stays valid even if the member's name or business slug changes.
model MemberCard {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  publicId    String   @unique
  enabled     Boolean  @default(true)
  showPhone   Boolean  @default(true)
  showEmail   Boolean  @default(true)
  showWebsite Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_cards")
}

// Member referral program ("Member Connect") — see specs/004-member-referral-program
model Referral {
  id                  Int      @id @default(autoincrement())
  referrerBusinessId  String   // ghlBusinessId of the giving member
  referrerUserId      Int      // User.id who submitted it
  recipientBusinessId String   // ghlBusinessId of the receiving member
  recipientUserId     Int?     // optional: a specific team member (User.id); null = visible to the whole recipient business
  leadBusinessId      String?  // set when the lead is a fellow member business (an introduction); such referrals earn no leaderboard points
  leadName            String   // never shown outside the two parties
  leadPhone           String   // required; visible only to referrer + recipient ("" only for member introductions with no directory phone)
  leadEmail           String?  // optional; visible only to referrer + recipient
  leadBusinessName    String?  // optional: the lead's own business, if any
  note                String?  @db.Text
  temperature         String?  // hot | warm | cold
  status              String   @default("submitted") // submitted | contacted | in_discussion | closed_won | closed_lost | not_a_fit
  hiddenByAdmin       Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  testimonials ReferralTestimonial[]

  @@index([referrerBusinessId])
  @@index([recipientBusinessId])
  @@index([recipientUserId])
  @@index([leadBusinessId])
  @@index([status])
  @@index([createdAt])
  @@map("referrals")
}

model ReferralTestimonial {
  id           Int      @id @default(autoincrement())
  referralId   Int
  authorUserId Int
  body         String   @db.Text
  createdAt    DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@map("referral_testimonials")
}

model ReferralPoints {
  id         Int      @id @default(autoincrement())
  businessId String   @unique // ghlBusinessId
  points     Int      @default(0)
  tier       String   @default("none") // none | bronze | silver | gold | platinum
  updatedAt  DateTime @updatedAt

  @@map("referral_points")
}

// Referral of a lead to a business that is NOT a chamber member (lead-gen for the chamber).
// The non-member never gets an account; they receive one email. Kept separate from Referral
// so the member-to-member flow, feed and leaderboard are unaffected.
model NonMemberReferral {
  id                 Int       @id @default(autoincrement())
  referrerBusinessId String    // ghlBusinessId of the member who gave the referral
  referrerUserId     Int       // User.id who submitted it
  businessName       String    // the non-member business being referred to
  contactName        String?   // optional team member at that business
  email              String    // required: where the invitation email goes
  phone              String?
  leadName           String    // never shown to the non-member or to admins
  leadPhone          String    // required
  leadEmail          String?   // optional
  leadBusinessName   String?   // optional: the lead's own business, if any
  note               String?   @db.Text
  temperature        String?   // hot | warm | cold
  status             String    @default("sent") // sent | joined | closed
  emailSentAt        DateTime? // null = email not sent (send failed)
  hiddenByAdmin      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([referrerBusinessId])
  @@index([email])
  @@index([createdAt])
  @@map("non_member_referrals")
}
